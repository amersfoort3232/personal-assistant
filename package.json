{
  "name": "personal-assistant-chatbot",
  "productName": "Personal Assistant",
  "version": "0.1.0",
  "description": "A Windows desktop assistant that plans approved tasks into Google Calendar.",
  "author": "Personal Assistant",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "set \"VITE_CONFIG_NATIVE_IGNORE_WARNING=true\" && electron-forge start",
    "package": "node scripts/assert-google-oauth-build-config.mjs && set \"PA_E2E_BUILD=\" && set \"PA_PRODUCTION=1\" && set \"VITE_CONFIG_NATIVE_IGNORE_WARNING=true\" && electron-forge package --arch=x64",
    "package:e2e": "set \"PA_E2E_BUILD=1\" && set \"PA_PRODUCTION=\" && set \"VITE_CONFIG_NATIVE_IGNORE_WARNING=true\" && electron-forge package --arch=x64",
    "make": "node scripts/assert-google-oauth-build-config.mjs && set \"PA_E2E_BUILD=\" && set \"PA_PRODUCTION=1\" && set \"VITE_CONFIG_NATIVE_IGNORE_WARNING=true\" && electron-forge make --arch=x64",
    "typecheck": "tsc --noEmit",
    "test": "set \"VITE_CONFIG_NATIVE_IGNORE_WARNING=true\" && vitest run",
    "test:watch": "set \"VITE_CONFIG_NATIVE_IGNORE_WARNING=true\" && vitest",
    "test:e2e": "playwright test",
    "assert:production-package": "node scripts/assert-production-package.mjs",
    "verify:fuses": "node scripts/verify-production-fuses.mjs",
    "verify:e2e": "npm run package:e2e && npm run test:e2e",
    "release:verify": "npm run check && npm run verify:e2e && npm run make && npm run assert:production-package && npm run verify:fuses",
    "check": "npm run typecheck && npm test"
  },
  "keywords": [],
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "extract-zip": "npm:@electron-internal/extract-zip@1.0.5"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "electron-log": "5.4.4",
    "luxon": "^3.7.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron/asar": "3.4.1",
    "@electron/fuses": "1.8.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/luxon": "^3.7.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "43.2.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
